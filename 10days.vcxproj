    <Exec Command="&quot;$(ProjectDir)Tools\CalyxLauncher.exe&quot; &quot;$(ProjectDir)10days.calyxproj&quot;" />
  </Target>
  <Target Name="ValidateCalyxEngineSdkDir" BeforeTargets="PrepareForBuild" DependsOnTargets="EnsureCalyxEngineSdk">
    <Error Condition="'$(CalyxEngineSdkDir)'==''" Text="CalyxEngineSdkDir is empty. Set CALYX_ENGINE_SDK_DIR or install the SDK under %LOCALAPPDATA%\CalyxEngine\Engines\$(CalyxEngineVersion)\SDK." />
