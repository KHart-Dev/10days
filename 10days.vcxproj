    <Error Condition="'$(CalyxEngineSdkDir)'!='' and !Exists('$(CalyxEngineSdkDir)\Include\Data\Engine')" Text="CalyxEngineSdkDir is missing Data headers. Update or reinstall the Calyx engine SDK: $(CalyxEngineSdkDir)" />
    <Error Condition="'$(CalyxEngineSdkDir)'!='' and !Exists('$(CalyxEngineSdkDir)\Include\externals\nlohmann\json.hpp')" Text="CalyxEngineSdkDir is missing external headers. Update or reinstall the Calyx engine SDK: $(CalyxEngineSdkDir)" />
    <Error Condition="'$(CalyxEngineSdkDir)'!='' and !Exists('$(CalyxReflectionTool)')" Text="Calyx reflection generator was not found. Update or reinstall the Calyx engine SDK: $(CalyxReflectionTool)" />
    <Error Condition="'$(CalyxEngineSdkDir)'!='' and !Exists('$(CalyxEngineSdkDir)\Lib\$(Configuration)\CalyxEngine.lib')" Text="CalyxEngine.lib was not found for $(Configuration). Update or reinstall the Calyx engine SDK: $(CalyxEngineSdkDir)" />
    <Error Condition="'$(CalyxEngineSdkDir)'!='' and !Exists('$(CalyxEngineSdkDir)\Bin\$(Configuration)\CalyxGame.exe')" Text="CalyxGame.exe was not found for $(Configuration). Update or reinstall the Calyx engine SDK: $(CalyxEngineSdkDir)" />
  </Target>
  <Target Name="GenerateCalyxGameReflection" BeforeTargets="ClCompile" DependsOnTargets="ValidateCalyxEngineSdkDir">
    <Message Importance="high" Text="Generating Calyx game object registry from 10days.calyxproj..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(CalyxReflectionTool)&quot; -ProjectFile &quot;$(ProjectDir)10days.calyxproj&quot; -OutputName CalyxGameObjectRegistry.generated -FunctionName RegisterGeneratedGameSceneObjects" />
  </Target>
  <Target Name="CopyCalyxGameHost" AfterTargets="Build" DependsOnTargets="ValidateCalyxEngineSdkDir">
    <Message Importance="high" Text="Copying the Calyx game host to $(TargetDir)$(ProjectName).exe..." />
    <Copy SourceFiles="$(CalyxEngineSdkDir)\Bin\$(Configuration)\CalyxGame.exe" DestinationFiles="$(TargetDir)$(ProjectName).exe" SkipUnchangedFiles="true" />
